# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# arquivo pessoal preservado do diretório original, fora do escopo do projeto
/scratch

