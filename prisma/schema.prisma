// Prisma schema for the VIP subscription manager.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// Status (ativo/expirado/cancelado) is derived at runtime from `cancelled` +
// `expiresAt` (see src/lib/status.ts) instead of stored, so it can never drift.
model Subscriber {
  id        String   @id @default(cuid())
  name      String
  contact   String
  plan      Plan
  startDate DateTime
  expiresAt DateTime
  cancelled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([expiresAt])
  @@index([name])
}

model Payment {
  id           String   @id @default(cuid())
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  amountCents  Int
  plan         Plan
  paidAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([subscriberId])
  @@index([paidAt])
}
